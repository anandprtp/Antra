# Private bot identity. Create the bot with @BotFather.
ANTRA_TELEGRAM_BOT_TOKEN=

# Option A: fixed allowlist of comma-separated numeric Telegram user IDs.
ANTRA_TELEGRAM_ALLOWED_USER_IDS=

# Option B: explicitly let the first human who writes in a private chat become
# the administrator. The admin can invite members with /invite.
ANTRA_TELEGRAM_CLAIM_FIRST_USER=false
ANTRA_TELEGRAM_ACCESS_DB=./.antra_telegram_access.sqlite3
ANTRA_TELEGRAM_INVITE_TTL_SECONDS=86400

# Owner-bound playlist button sessions survive bot restarts in this SQLite file.
ANTRA_TELEGRAM_PLAYLIST_DB=./playlist_sessions.sqlite3
ANTRA_TELEGRAM_PLAYLIST_SESSION_TTL_SECONDS=86400
ANTRA_TELEGRAM_MAX_PLAYLIST_TRACKS=100
ANTRA_TELEGRAM_PLAYLIST_PAGE_SIZE=10
ANTRA_TELEGRAM_MAX_PLAYLIST_URL_CHARS=2048

# Existing Antra library. Defaults to OUTPUT_DIR or ./Music.
ANTRA_TELEGRAM_LIBRARY_DIR=./Music

# library: only return files already owned by the operator (default)
# download: if missing locally, use Antra's configured source chain for personal authorised use
ANTRA_TELEGRAM_RESOLVE_MODE=library

# auto: Telegram audio/document when possible, VLC link for large files
# audio: prefer Telegram upload; vlc: always return an M3U8 link
ANTRA_TELEGRAM_DELIVERY_MODE=auto
ANTRA_TELEGRAM_DOWNLOAD_FORMAT=mp3
# YouTube-only download path for title searches and exact YouTube Music links.
ANTRA_TELEGRAM_FAST_MODE=true
# Large recordings are sent as several Telegram documents without transcoding.
ANTRA_TELEGRAM_SPLIT_LARGE_AUDIO=true
ANTRA_TELEGRAM_MAX_UPLOAD_BYTES=49000000

# Required for VLC links. Put this service behind HTTPS and set the public origin.
# Generate a unique secret with: openssl rand -hex 32
ANTRA_TELEGRAM_PUBLIC_BASE_URL=
ANTRA_TELEGRAM_LINK_SECRET=
ANTRA_TELEGRAM_LINK_TTL_SECONDS=86400
ANTRA_TELEGRAM_BIND_HOST=127.0.0.1
ANTRA_TELEGRAM_BIND_PORT=8090

ANTRA_TELEGRAM_MAX_CONCURRENT_JOBS=1
ANTRA_TELEGRAM_MAX_PENDING_JOBS=20
